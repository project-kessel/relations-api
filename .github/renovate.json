{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dockerfile": {
    "schedule": ["* 0-7 * * 0"]
  },
  "gomod": {
    "schedule": ["* 0-7 * * 0"]
  },
  "packageRules": [
    {
      "matchManagers": ["gomod", "github-actions"],
      "enabled": true,
      "groupName": "Dependency updates",
      "group": {
        "branchTopic": "dependency-updates",
        "commitMessageTopic": "dependencies"
      }
    },
    {
      "description": "Disable go-kratos major updates",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/go-kratos/**"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
